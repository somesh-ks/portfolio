# Copy to .env.local (never committed). See docs/protected-content.md.

# scrypt hash of the sharing password: `bun run auth:hash "<password>"`
PORTFOLIO_PASSWORD_HASH=
# Optional extra password that opens only one case study, e.g. ROYC
# PORTFOLIO_PASSWORD_ROYC_HASH=
# PORTFOLIO_PASSWORD_LUMINOVO_HASH=

# 32+ random bytes, base64: `openssl rand -base64 32`
PORTFOLIO_COOKIE_SECRET=

# Where the protected MDX bodies and media live. Either a local directory
# (default: content/protected, gitignored) or an https base URL.
# PROTECTED_CONTENT_SOURCE=https://<private-store>/portfolio-protected
# Bearer token for the https source. Defaults to BLOB_READ_WRITE_TOKEN (Vercel Blob).
# PROTECTED_CONTENT_TOKEN=
