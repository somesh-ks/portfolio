{
  "$description": "Usage: text and text-subtle sit on bg and bg-subtle. action-purple-fg is the label on action-purple buttons. focus is the 2px focus ring on bg.",
  "gray": {
    "$type": "color",
    "0": { "$value": "#ffffff" },
    "50": { "$value": "#fafafa" },
    "75": { "$value": "#f9f9f9" },
    "200": { "$value": "#e4e4e7" },
    "250": { "$value": "#e5e5e6" },
    "400": { "$value": "#a1a1aa" },
    "500": { "$value": "#71717a" },
    "600": { "$value": "#52525b" },
    "900": { "$value": "#18181b" },
    "950": { "$value": "#09090b" }
  },
  "violet": {
    "$type": "color",
    "500": { "$value": "#8b5cf6" },
    "600": { "$value": "#7c3aed" }
  },
  "color": {
    "$type": "color",
    "bg": { "$value": "{gray.0}", "$extensions": { "mode": { "dark": "{gray.950}" } } },
    "bg-subtle": { "$value": "{gray.50}", "$extensions": { "mode": { "dark": "{gray.900}" } } },
    "surface-raised": { "$value": "{gray.75}", "$extensions": { "mode": { "dark": "{gray.900}" } } },
    "text": { "$value": "{gray.900}", "$extensions": { "mode": { "dark": "{gray.50}" } } },
    "text-subtle": { "$value": "{gray.500}", "$extensions": { "mode": { "dark": "{gray.600}" } } },
    "text-disabled": { "$value": "{gray.400}" },
    "border": { "$value": "{gray.200}" },
    "divider": { "$value": "{gray.250}" },
    "action-purple": { "$value": "{violet.600}" },
    "action-purple-fg": { "$value": "{gray.0}" },
    "focus": { "$value": "{violet.500}" }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "caption": { "$value": { "value": 12, "unit": "px" } },
      "sm": { "$value": { "value": 13, "unit": "px" } },
      "body": { "$value": { "value": 14, "unit": "px" } },
      "lg": { "$value": { "value": 18, "unit": "px" } },
      "h2": { "$value": { "value": 24, "unit": "px" } },
      "h1": { "$value": { "value": 32, "unit": "px" } }
    }
  },
  "typography": {
    "$type": "typography",
    "caption": { "$value": { "fontFamily": "Inter", "fontSize": "{font.size.caption}", "fontWeight": 300, "lineHeight": 1.4 } },
    "body": { "$value": { "fontFamily": "Inter", "fontSize": "{font.size.body}", "fontWeight": 400, "lineHeight": 1.2 } },
    "h1": { "$value": { "fontFamily": "Inter", "fontSize": "{font.size.h1}", "fontWeight": 700, "lineHeight": 1.2 } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } }
  }
}
